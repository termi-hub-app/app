{
  "name": "termihub",
  "version": "1.0.0-b4",
  "author": "liveweeeb",
  "main": "src/main.js",
  "scripts": {
    "rebuild": "node-gyp rebuild --target=$(electron -v | sed 's/v//') --arch=x64 --dist-url=https://electronjs.org/headers --cpp_std=c++20",
    "start": "electron ./src/main.js",
    "build:windows": "electron-builder --w --x64 && electron-builder --w --arm64",
    "build:mac": "electron-builder --m",
    "build:linux": "electron-builder --l",
    "build:all": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.4.6",
    "electron-builder": "^25.1.8",
    "electron-rebuild": "^3.2.9",
    "node-addon-api": "^8.3.1",
    "node-gyp": "^11.1.0"
  },
  "gypfile": true,
  "dependencies": {
    "adm-zip": "^0.5.16",
    "discord-rpc": "^4.0.1",
    "node-disk-info": "^1.3.0",
    "ping": "^0.4.4",
    "toml": "^3.0.0",
    "traceroute": "^1.0.0"
  },
  "build": {
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "appId": "com.liveweeeb.termihub",
    "productName": "TermiHub",
    "files": [
      "node_modules/**/*",
      "src/**/*",
      "logo.ico",
      "package-lock.json",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "logo.ico",
      "asar": true
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "icon": "logo.svg",
      "executableName": "termihub",
      "category": "Utility"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "logo.icns",
      "category": "public.app-category.developer-tools",
      "darkModeSupport": true
    },
    "nsis": {
      "perMachine": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "electronVersion": "33.4.4"
  }
}
